{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "sourceIndex": {
      "type": "integer",
      "title": "Source row"
    },
    "jobId": {
      "type": "string",
      "title": "Job ID"
    },
    "title": {
      "type": "string",
      "title": "Job title"
    },
    "company": {
      "type": "string",
      "title": "Company"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "linkedinUrl": {
      "type": "string",
      "title": "LinkedIn URL"
    },
    "status": {
      "type": "string",
      "title": "Decision",
      "enum": [
        "ACTIVE",
        "AUTHORIZED_APPLY_ROUTE",
        "LINKEDIN_EASY_APPLY",
        "EXPIRED",
        "SOURCE_MISMATCH",
        "STATUS_CONFLICT",
        "AMBIGUOUS",
        "INVALID_INPUT",
        "DUPLICATE_INPUT"
      ]
    },
    "actionUrl": {
      "type": [
        "string",
        "null"
      ],
      "title": "Safe action URL"
    },
    "officialUrl": {
      "type": [
        "string",
        "null"
      ],
      "title": "Official URL"
    },
    "safeToPublish": {
      "type": "boolean",
      "title": "Safe to publish"
    },
    "reviewRequired": {
      "type": "boolean",
      "title": "Review required"
    },
    "usefulClassification": {
      "type": "boolean",
      "title": "Useful result"
    },
    "confidence": {
      "type": "number",
      "title": "Confidence"
    },
    "sourceProvider": {
      "type": [
        "string",
        "null"
      ],
      "title": "Source"
    },
    "evidence": {
      "type": "array",
      "title": "Evidence",
      "items": {
        "type": "string"
      }
    },
    "checkedAt": {
      "type": "string",
      "title": "Checked at"
    },
    "original": {
      "type": "object",
      "title": "Original row"
    }
  },
  "required": [
    "sourceIndex",
    "jobId",
    "title",
    "company",
    "location",
    "linkedinUrl",
    "status",
    "safeToPublish",
    "reviewRequired",
    "usefulClassification",
    "confidence",
    "evidence",
    "checkedAt",
    "original"
  ],
  "title": "LinkedIn job apply-link verification record"
}
